# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram id владельца (обязательно). Владелец всегда допущен и получает
# карточки с запросами доступа. Узнать id: @userinfobot
OWNER_ID=

# Куда слать предупреждения (мало места на диске, ошибки загрузки).
# Обычно тот же id, что и OWNER_ID. Пусто = предупреждений нет.
ADMIN_CHAT_ID=

# Пути к утилитам (если они в PATH, менять не нужно)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Рабочая папка для временных файлов. Папка data/ (allowed.json, usage.jsonl)
# создаётся рядом, на уровень выше TMP_DIR.
TMP_DIR=./tmp

# Сколько загрузок одновременно
QUEUE_CONCURRENCY=1
# Таймаут одной загрузки, секунд
DOWNLOAD_TIMEOUT_SEC=600
# Не принимать задания, если свободного места меньше, МБ
MIN_FREE_DISK_MB=2000
# Максимальный размер файла, МБ (с локальным Bot API до ~1900)
MAX_FILESIZE_MB=1900

# Локальный Telegram Bot API (лимит файла 2 ГБ вместо 50 МБ).
# Пусто = обычный api.telegram.org (лимит 50 МБ, тогда снизь MAX_FILESIZE_MB до 45).
TELEGRAM_API_ROOT=
